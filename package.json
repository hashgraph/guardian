{
    "devDependencies": {
        "detect-secrets": "^1.0.6"
    },
    "engines": {
        "node": ">=24.15.0"
    },
    "name": "guardian",
    "packageManager": "yarn@4.18.1",
    "private": true,
    "resolutions": {
        "@mattrglobal/bls12381-key-pair": "2.0.0",
        "@mattrglobal/bbs-signatures": "2.0.0",
        "protobufjs": "8.6.6",
        "@helia/delegated-routing-v1-http-api-client@npm:^9.0.0": "patch:@helia/delegated-routing-v1-http-api-client@npm%3A9.0.2#~/.yarn/patches/@helia-delegated-routing-v1-http-api-client-npm-9.0.2-6de9c71dd5.patch"
    },
    "scripts": {
        "clean": "find . -type d \\( -name dist -o -name node_modules \\) -prune -exec rm -rf {} +",
        "detect-secrets": "detect-secrets-launcher --word-list exclude-secrets.txt k8s-manifests/**/* */src/**.ts **/.env*",
        "lint": "./utils/lint-all.sh",
        "publish-policies": "guardian-cli publish-policies \"Methodology Library\" -c \"configs/automatic-publish-policies.config.json\" -o \"published-policies.txt\""
    },
    "version": "3.8.0-rc",
    "workspaces": [
        "interfaces",
        "common",
        "hedera",
        "ai-service",
        "analytics-service",
        "api-gateway",
        "application-events",
        "auth-service",
        "guardian-cli",
        "guardian-service",
        "logger-service",
        "mrv-sender",
        "notification-service",
        "policy-service",
        "queue-service",
        "topic-listener-service",
        "topic-viewer",
        "tree-viewer",
        "worker-service",
        "indexer-interfaces",
        "indexer-common",
        "indexer-api-gateway",
        "indexer-service",
        "indexer-worker-service"
    ]
}
