{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EWD-RB Waste Batch",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "methodology_id": {
      "type": "string",
      "const": "EWD-RB"
    },
    "methodology_version": {
      "type": "string",
      "const": "0.3"
    },
    "schema_version": {
      "type": "string",
      "const": "0.3.0"
    },
    "batch_id": {
      "$ref": "#/$defs/identifier"
    },

    "batch_closed_at": {
      "type": "string",
      "format": "date-time"
    },
    "processing_route": {
      "type": "string",
      "enum": [
        "bsf_bioconversion",
        "composting",
        "mixed",
        "other"
      ]
    },
    "delivery_ids": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/identifier"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "batch_kg_ajustados_total": {
      "type": "number",
      "minimum": 0,
      "description": "Auto Calculate"
    },
    "batch_status": {
      "type": "string",
      "enum": [
        "Draft",
        "Populated",
        "Closed",
        "Calculated",
        "Locked",
        "Superseded",
        "Invalidated"
      ]
    },
    "batch_evidence": {
      "$ref": "#/$defs/evidenceRefs"
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1
    },
    "evidenceRefs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    }
  },
  "required": [
    "methodology_id",
    "methodology_version",
    "schema_version",
    "batch_id",
    "processing_route",
    "delivery_ids",
    "batch_status",
    "batch_evidence"
  ]
}
