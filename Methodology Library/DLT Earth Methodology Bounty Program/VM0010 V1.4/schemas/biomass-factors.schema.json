{
    "name": "VM0010 Biomass Factors",
    "description": "Slice-scoped output of logic/calculate-biomass-factors.js. Carries Equation A02 alternative factor construction: BCEF_R = BEF_R * D, both in t dry matter / m3 per species/stratum.",
    "entity": "VC",
    "system": false,
    "sourceVersion": "1.0.0",
    "document": {
        "$id": "#biomass-factors",
        "title": "VM0010 Biomass Factors",
        "type": "object",
        "required": ["@context", "type", "credentialSubject"],
        "properties": {
            "@context": { "type": "array", "items": { "type": "string" }, "readOnly": true },
            "type": { "type": "array", "items": { "type": "string" }, "readOnly": true },
            "credentialSubject": {
                "type": "array",
                "minItems": 1,
                "items": { "$ref": "#biomass-factors-subject" }
            }
        },
        "defs": {
            "biomass-factors-subject": {
                "type": "object",
                "required": ["ref", "year", "rows"],
                "properties": {
                    "ref": { "type": "string", "title": "Project ID", "minLength": 1 },
                    "year": { "type": "integer", "title": "Monitoring Year", "minimum": 1900, "maximum": 2200 },
                    "rows": {
                        "type": "array",
                        "title": "Biomass Factor Results",
                        "minItems": 1,
                        "items": {
                            "type": "object",
                            "required": ["species", "stratum", "befR", "d", "bcefR"],
                            "properties": {
                                "species": {
                                    "type": "integer",
                                    "title": "j (Tree Species)",
                                    "minimum": 1,
                                    "maximum": 3
                                },
                                "stratum": {
                                    "type": "integer",
                                    "title": "i (Stratum)",
                                    "minimum": 1,
                                    "maximum": 3
                                },
                                "befR": {
                                    "type": "number",
                                    "title": "BEF_R biomass expansion factor, dimensionless",
                                    "minimum": 0,
                                    "exclusiveMinimum": 0
                                },
                                "d": {
                                    "type": "number",
                                    "title": "D wood density (t dry matter / m3)",
                                    "minimum": 0,
                                    "exclusiveMinimum": 0
                                },
                                "bcefR": {
                                    "type": "number",
                                    "title": "BCEF_R biomass conversion and expansion factor (t dry matter / m3)",
                                    "minimum": 0,
                                    "exclusiveMinimum": 0
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
