{
    "name": "VM0010 Fire Disturbance Baseline Biomass",
    "description": "Slice-scoped output of logic/calculate-fire-disturbance-822.js. Carries Equation (34) baseline biomass absent: B_i,t|PRJ = SUM_j(V_EX,j,i|BSL * BCEF_R), t dry matter/ha per species/stratum.",
    "entity": "VC",
    "system": false,
    "sourceVersion": "1.0.0",
    "document": {
        "$id": "#fire-disturbance-822",
        "title": "VM0010 Fire Disturbance Baseline Biomass",
        "type": "object",
        "required": ["@context", "type", "credentialSubject"],
        "properties": {
            "@context": { "type": "array", "items": { "type": "string" }, "readOnly": true },
            "type": { "type": "array", "items": { "type": "string" }, "readOnly": true },
            "credentialSubject": {
                "type": "array",
                "minItems": 1,
                "items": { "$ref": "#fire-disturbance-822-subject" }
            }
        },
        "defs": {
            "fire-disturbance-822-subject": {
                "type": "object",
                "required": ["ref", "year", "rows"],
                "properties": {
                    "ref": { "type": "string", "title": "Project ID", "minLength": 1 },
                    "year": { "type": "integer", "title": "Monitoring Year", "minimum": 1900, "maximum": 2200 },
                    "rows": {
                        "type": "array",
                        "title": "Baseline Biomass Absent Results",
                        "minItems": 1,
                        "items": {
                            "type": "object",
                            "required": ["species", "stratum", "vExJiBsl", "bcefR", "bAbsentJiBsl"],
                            "properties": {
                                "species": {
                                    "type": "integer",
                                    "title": "j (Tree Species)",
                                    "minimum": 1,
                                    "maximum": 3
                                },
                                "stratum": {
                                    "type": "integer",
                                    "title": "i (Stratum)",
                                    "minimum": 1,
                                    "maximum": 3
                                },
                                "vExJiBsl": {
                                    "type": "number",
                                    "title": "V_EX,j,i|BSL merchantable extraction volume (m3/ha)",
                                    "minimum": 0
                                },
                                "bcefR": {
                                    "type": "number",
                                    "title": "BCEF_R biomass conversion and expansion factor (t dry matter / m3)",
                                    "minimum": 0,
                                    "exclusiveMinimum": 0
                                },
                                "bAbsentJiBsl": {
                                    "type": "number",
                                    "title": "B_i,t|PRJ baseline biomass absent (t dry matter / ha)",
                                    "minimum": 0
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
