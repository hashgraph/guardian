                                    "title": "Stratum i",
                                    "minimum": 1,
                                    "maximum": 3
                                },
                                "carbontPerHectare": {
                                    "type": "number",
                                    "title": "C_AB,j,i,t,sp|PRJ (tC)",
                                    "minimum": 0
                                }
                            }
                        }
                    },
                    "meanStockDensity": {
                        "type": "array",
                        "title": "Mean Stock Density (Eq 31)",
                        "minItems": 1,
                        "items": {
                            "type": "object",
                            "required": ["species", "stratum", "carbontPerHectare"],
                            "properties": {
                                "species": {
                                    "type": "integer",
                                    "title": "Species j",
                                    "minimum": 1,
                                    "maximum": 3
                                },
                                "stratum": {
                                    "type": "integer",
                                    "title": "Stratum i",
                                    "minimum": 1,
                                    "maximum": 3
                                },
                                "carbontPerHectare": {
                                    "type": "number",
                                    "title": "C_AB,i,t|PRJ (tC/ha)",
                                    "minimum": 0
