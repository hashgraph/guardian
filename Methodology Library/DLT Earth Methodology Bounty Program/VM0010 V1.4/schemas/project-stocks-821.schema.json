                        "minimum": 0
                    },
                    "monitoringInterval": {
                        "type": "object",
                        "title": "Monitoring Interval (Eq 32)"
                    },
                    "annualStockGainDetails": {
                        "type": "array",
                        "title": "Annual Stock Gain Details (Eq 32)"
                    },
                    "bAbsentLookup": {
                        "type": "object",
                        "title": "Baseline Biomass Absent Lookup (Eq 34)"
                    },
                    "fireMethaneEmissions": {
        "type": "number",
        "title": "Fire Methane Emissions DC_DIST-FR,t|PRJ (tCO2e)",
        "minimum": 0
    },
                    "fireDetails": {
                        "type": "array",
                        "title": "Per-Fire Details (Eq 33)",
