{
    "name": "VM0010 Section 8.1.3-8.1.4 Project Stocks and Disturbance",
    "description": "Slice-scoped output of logic/calculate-project-stocks-821.js. Carries Eqs 29-33: project plot carbon, mean stock density, annual stock gain, and fire methane emissions.",
    "entity": "VC",
    "system": false,
    "sourceVersion": "1.0.0",
    "document": {
