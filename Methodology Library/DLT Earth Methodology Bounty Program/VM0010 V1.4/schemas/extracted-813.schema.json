{
    "name": "VM0010 Section 8.1.3 Extracted Timber Across Species",
    "description": "Slice-scoped output of logic/calculate-extracted-813.js. Carries Equation (8) C_EX,i|BSL only, in tC per hectare.",
    "entity": "VC",
    "system": false,
    "sourceVersion": "1.0.0",
    "document": {
        "$id": "#extracted-813",
        "title": "VM0010 Section 8.1.3 Extracted Timber Across Species",
        "type": "object",
        "required": ["@context", "type", "credentialSubject"],
        "properties": {
            "@context": { "type": "array", "items": { "type": "string" }, "readOnly": true },
            "type": { "type": "array", "items": { "type": "string" }, "readOnly": true },
            "credentialSubject": {
                "type": "array",
                "minItems": 1,
                "items": { "$ref": "#extracted-813-subject" }
            }
        },
        "defs": {
            "extracted-813-subject": {
                "type": "object",
                "required": ["ref", "year", "rows", "sumOfStrataTotalsTC"],
                "properties": {
                    "ref": { "type": "string", "title": "Project ID" },
                    "year": { "type": "integer", "title": "Monitoring Year" },
                    "rows": {
                        "type": "array",
                        "title": "Per Stratum Results",
                        "minItems": 1,
                        "items": {
                            "type": "object",
                            "required": ["stratum", "species", "cExJiBsl", "cExIBsl"],
                            "properties": {
                                "stratum": { "type": "integer", "title": "i (Stratum)", "minimum": 1, "maximum": 3 },
                                "species": {
                                    "type": "array",
                                    "title": "j (Tree Species) contributing to this stratum",
                                    "minItems": 1,
                                    "uniqueItems": true,
                                    "items": { "type": "integer", "minimum": 1, "maximum": 3 }
                                },
                                "cExJiBsl": {
                                    "type": "array",
                                    "title": "C_EX,j,i|BSL summands (tC/ha), aligned to species",
                                    "minItems": 1,
                                    "items": { "type": "number", "minimum": 0 }
                                },
                                "cExIBsl": {
                                    "type": "number",
                                    "title": "C_EX,i|BSL (tC/ha) - Equation 8",
                                    "description": "Sum over j of C_EX,j,i|BSL for this stratum.",
                                    "minimum": 0
                                }
                            }
                        }
                    },
                    "sumOfStrataTotalsTC": {
                        "type": "number",
                        "title": "Arithmetic sum of the per-stratum C_EX,i|BSL values (tC/ha summed)",
                        "description": "Not an Equation (8) term. Reported for multi-stratum inspection only; not a per-hectare project quantity because each stratum summand is itself per hectare."
                    }
                }
            }
        }
    }
}