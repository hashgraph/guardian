{
    "name": "VM0010 Non-CO2 Emission Factor",
    "description": "Slice-scoped output of logic/calculate-non-co2-emission-factor.js. Carries Equation (47): EF = EF_CH4 * GWP_CH4 + EF_N2O * GWP_N2O, tCO2e per activity unit.",
    "entity": "VC",
    "system": false,
    "sourceVersion": "1.0.0",
    "document": {
        "$id": "#non-co2-emission-factor",
        "title": "VM0010 Non-CO2 Emission Factor",
        "type": "object",
        "required": ["@context", "type", "credentialSubject"],
        "properties": {
            "@context": { "type": "array", "items": { "type": "string" }, "readOnly": true },
            "type": { "type": "array", "items": { "type": "string" }, "readOnly": true },
            "credentialSubject": {
                "type": "array",
                "minItems": 1,
                "items": { "$ref": "#non-co2-emission-factor-subject" }
            }
        },
        "defs": {
            "non-co2-emission-factor-subject": {
                "type": "object",
                "required": ["ref", "year", "rows", "sumEfTco2ePerActivity"],
                "properties": {
                    "ref": { "type": "string", "title": "Project ID", "minLength": 1 },
                    "year": { "type": "integer", "title": "Monitoring Year", "minimum": 1900, "maximum": 2200 },
                    "rows": {
                        "type": "array",
                        "title": "GHG Factor Rows",
                        "minItems": 1,
                        "items": {
                            "type": "object",
                            "required": ["gas", "activity", "efCh4", "gwpCh4", "efN2o", "gwpN2o", "efTco2ePerActivity"],
                            "properties": {
                                "gas": { "type": "string", "title": "Gas profile identifier" },
                                "activity": { "type": "string", "title": "Activity unit denominator" },
                                "efCh4": { "type": "number", "title": "EF_CH4 (tCH4 per activity unit)", "minimum": 0 },
                                "gwpCh4": { "type": "number", "title": "GWP_CH4 (dimensionless)", "minimum": 0 },
                                "efN2o": { "type": "number", "title": "EF_N2O (tN2O per activity unit)", "minimum": 0 },
                                "gwpN2o": { "type": "number", "title": "GWP_N2O (dimensionless)", "minimum": 0 },
                                "efTco2ePerActivity": { "type": "number", "title": "EF (tCO2e per activity unit)", "minimum": 0 }
                            }
                        }
                    },
                    "sumEfTco2ePerActivity": { "type": "number", "title": "Sum of EF over all GHG profiles (tCO2e per activity unit)" }
                }
            }
        }
    }
}