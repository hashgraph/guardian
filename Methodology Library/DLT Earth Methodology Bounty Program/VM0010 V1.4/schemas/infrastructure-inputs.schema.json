{
    "name": "VM0010 Infrastructure Volume Partition",
    "description": "Slice-scoped output of logic/calculate-infrastructure-inputs.js. Carries Equation A01 infrastructure volume partition: V_EX,INF = F_V,INF,HWP * V_cleared and V_notEX,INF = (1-F_V,INF,HWP) * V_cleared, both in m3/ha per species/stratum.",
    "entity": "VC",
    "system": false,
    "sourceVersion": "1.0.0",
    "document": {
        "$id": "#infrastructure-inputs",
        "title": "VM0010 Infrastructure Volume Partition",
        "type": "object",
        "required": ["@context", "type", "credentialSubject"],
        "properties": {
            "@context": { "type": "array", "items": { "type": "string" }, "readOnly": true },
            "type": { "type": "array", "items": { "type": "string" }, "readOnly": true },
            "credentialSubject": {
                "type": "array",
                "minItems": 1,
                "items": { "$ref": "#infrastructure-inputs-subject" }
            }
        },
        "defs": {
            "infrastructure-inputs-subject": {
                "type": "object",
                "required": ["ref", "year", "rows"],
                "properties": {
                    "ref": { "type": "string", "title": "Project ID", "minLength": 1 },
                    "year": { "type": "integer", "title": "Monitoring Year", "minimum": 1900, "maximum": 2200 },
                    "rows": {
                        "type": "array",
                        "title": "Infrastructure Volume Partition Results",
                        "minItems": 1,
                        "items": {
                            "type": "object",
                            "required": ["species", "stratum", "vCleared", "vInfHwp", "vExInfJiBsl", "vNotExInfJiBsl"],
                            "properties": {
                                "species": {
                                    "type": "integer",
                                    "title": "j (Tree Species)",
                                    "minimum": 1,
                                    "maximum": 3
                                },
                                "stratum": {
                                    "type": "integer",
                                    "title": "i (Stratum)",
                                    "minimum": 1,
                                    "maximum": 3
                                },
                                "vCleared": {
                                    "type": "number",
                                    "title": "V_cleared total volume cleared (m3)",
                                    "minimum": 0
                                },
                                "vInfHwp": {
                                    "type": "number",
                                    "title": "F_V,INF,HWP fraction allocated to infrastructure",
                                    "minimum": 0,
                                    "maximum": 1
                                },
                                "vExInfJiBsl": {
                                    "type": "number",
                                    "title": "V_EX,INF infrastructure volume (m3/ha)",
                                    "minimum": 0
                                },
                                "vNotExInfJiBsl": {
                                    "type": "number",
                                    "title": "V_notEX,INF non-extracted infrastructure volume (m3/ha)",
                                    "minimum": 0
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}