{
    "name": "VM0010 Plot Volume",
    "description": "Slice-scoped output of logic/calculate-plot-volume-811.js. Carries Equation (1) plot merchantable volume V_j,i,sp = SUM V_l,j,i,sp and Equation (2) mean plot density V_j,i|BSL = (1/SP) * SUM_sp(V_j,i,sp / A_sp).",
    "entity": "VC",
    "system": false,
    "sourceVersion": "1.0.0",
    "document": {
        "$id": "#plot-volume-811",
        "title": "VM0010 Plot Volume",
        "type": "object",
        "required": ["@context", "type", "credentialSubject"],
        "properties": {
            "@context": { "type": "array", "items": { "type": "string" }, "readOnly": true },
            "type": { "type": "array", "items": { "type": "string" }, "readOnly": true },
            "credentialSubject": {
                "type": "array",
                "minItems": 1,
                "items": { "$ref": "#plot-volume-811-subject" }
            }
        },
        "defs": {
            "plot-volume-811-subject": {
                "type": "object",
                "required": ["ref", "year", "plotVolumes", "meanVolumes", "totalPlots", "totalSpeciesStratumCombinations"],
                "properties": {
                    "ref": { "type": "string", "title": "Project ID", "minLength": 1 },
                    "year": { "type": "integer", "title": "Monitoring Year", "minimum": 1900, "maximum": 2200 },
                    "plotVolumes": {
                        "type": "array",
                        "title": "Plot Merchantable Volume Results",
                        "minItems": 1,
                        "items": {
                            "type": "object",
                            "required": ["plotId", "species", "stratum", "plotMerchantableVolume", "plotArea", "density", "isValid"],
                            "properties": {
                                "plotId": { "type": "string", "title": "Plot Identifier" },
                                "species": { "type": "integer", "title": "j (Tree Species)", "minimum": 1, "maximum": 3 },
                                "stratum": { "type": "integer", "title": "i (Stratum)", "minimum": 1, "maximum": 3 },
                                "plotMerchantableVolume": { "type": "number", "title": "V_j,i,sp|BSL Plot Merchantable Volume (m3)", "minimum": 0 },
                                "plotArea": { "type": "number", "title": "Plot Area (ha)", "minimum": 0, "exclusiveMinimum": 0 },
                                "density": { "type": "number", "title": "Plot Density (m3/ha)", "minimum": 0 },
                                "isValid": { "type": "boolean", "title": "Validation Flag" }
                            }
                        }
                    },
                    "meanVolumes": {
                        "type": "array",
                        "title": "Mean Volume Per Hectare by Species/Stratum",
                        "minItems": 1,
                        "items": {
                            "type": "object",
                            "required": ["plotId", "species", "stratum", "plotMerchantableVolume", "plotArea", "meanVolumePerHectare", "isValid"],
                            "properties": {
                                "plotId": { "type": "string", "title": "Representative Plot Identifier" },
                                "species": { "type": "integer", "title": "j (Tree Species)", "minimum": 1, "maximum": 3 },
                                "stratum": { "type": "integer", "title": "i (Stratum)", "minimum": 1, "maximum": 3 },
                                "plotMerchantableVolume": { "type": "number", "title": "Reference Plot Merchantable Volume (m3)", "minimum": 0 },
                                "plotArea": { "type": "number", "title": "Reference Plot Area (ha)", "minimum": 0, "exclusiveMinimum": 0 },
                                "meanVolumePerHectare": { "type": "number", "title": "Mean Volume Per Hectare V_j,i|BSL (m3/ha)", "minimum": 0 },
                                "isValid": { "type": "boolean", "title": "Validation Flag" }
                            }
                        }
                    },
                    "totalPlots": { "type": "integer", "title": "Total Number of Plots", "minimum": 1 },
                    "totalSpeciesStratumCombinations": { "type": "integer", "title": "Number of Distinct Species/Stratum Combinations", "minimum": 1 }
                }
            }
        }
    }
}