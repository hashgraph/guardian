{
    "name": "VM0010 Unit Conversion and Gas Parameters",
    "description": "Typed/provenance input contracts for units, gas parameters and evidence gates used across VM0010 v1.4 calculation modules.",
    "entity": "VC",
    "system": false,
    "sourceVersion": "1.0.0",
    "document": {
        "$id": "#vm0010-unit-conversion",
        "title": "VM0010 Unit Conversion and Gas Parameters Input Contracts",
        "type": "object",
        "required": ["@context", "type", "credentialSubject"],
        "properties": {
            "@context": { "type": "array", "items": { "type": "string" }, "readOnly": true },
            "type": { "type": "array", "items": { "type": "string" }, "readOnly": true },
            "credentialSubject": {
                "type": "array",
                "minItems": 1,
                "items": { "$ref": "#vm0010-unit-conversion-subject" }
            }
        },
        "defs": {
            "vm0010-unit-conversion-subject": {
                "type": "object",
                "required": [
                    "ref",
                    "monitoringYear",
                    "carbonToCo2Conversion",
                    "gasParameters",
                    "scope",
                    "period",
                    "recordKeys",
                    "validationStatus",
                    "validatedAt"
                ],
                "properties": {
                    "ref": { "type": "string", "title": "Project ID", "minLength": 1 },
                    "monitoringYear": { "type": "integer", "title": "Monitoring Year", "minimum": 1900, "maximum": 2200 },
                    "carbonToCo2Conversion": {
                        "type": "object",
                        "title": "Carbon to CO2 Conversion Factor",
                        "required": ["factor", "unitFrom", "unitTo"],
                        "properties": {
                            "factor": { "type": "number", "title": "Conversion Factor (44/12)", "minimum": 0 },
                            "unitFrom": { "type": "string", "title": "Source Unit", "enum": ["tC"] },
                            "unitTo": { "type": "string", "title": "Target Unit", "enum": ["tCO2e"] }
                        }
                    },
                    "gasParameters": {
                        "type": "object",
                        "title": "Gas Parameters and GWPs",
                        "required": ["gwpCH4", "gwpN2O", "ch4EmissionFactor", "n2oEmissionFactor"],
                        "properties": {
                            "gwpCH4": {
                                "type": "number",
                                "title": "CH4 GWP (kg CO2e/kg CH4)",
                                "minimum": 0,
                                "exclusiveMinimum": 0
                            },
                            "gwpN2O": {
                                "type": "number",
                                "title": "N2O GWP (kg CO2e/kg N2O)",
                                "minimum": 0,
                                "exclusiveMinimum": 0
                            },
                            "ch4EmissionFactor": {
                                "type": "object",
                                "title": "CH4 Emission Factor",
                                "required": ["value", "unit", "source"],
                                "properties": {
                                    "value": { "type": "number", "title": "Emission Factor Value", "minimum": 0, "exclusiveMinimum": 0 },
                                    "unit": { "type": "string", "title": "Unit", "enum": ["g/kg", "kg/t"] },
                                    "source": { "type": "string", "title": "Source/Documentation", "minLength": 1 }
                                }
                            },
                            "n2oEmissionFactor": {
                                "type": "object",
                                "title": "N2O Emission Factor",
                                "required": ["value", "unit", "source"],
                                "properties": {
                                    "value": { "type": "number", "title": "Emission Factor Value", "minimum": 0, "exclusiveMinimum": 0 },
                                    "unit": { "type": "string", "title": "Unit", "enum": ["g/kg", "kg/t"] },
                                    "source": { "type": "string", "title": "Source/Documentation", "minLength": 1 }
                                }
                            }
                        }
                    },
                    "scope": {
                        "type": "object",
                        "title": "Calculation Scope",
                        "required": ["baselineScenario", "projectScenario", "exclusive"],
                        "properties": {
                            "baselineScenario": { "type": "string", "title": "Baseline Scenario Identifier", "minLength": 1 },
                            "projectScenario": { "type": "string", "title": "Project Scenario Identifier", "minLength": 1 },
                            "exclusive": {
                                "type": "array",
                                "title": "Exclusive Clauses",
                                "items": { "type": "string" }
                            }
                        }
                    },
                    "period": {
                        "type": "object",
                        "title": "Calculation Period",
                        "required": ["startYear", "endYear", "durationYears"],
                        "properties": {
                            "startYear": { "type": "integer", "title": "Period Start Year", "minimum": 1900, "maximum": 2200 },
                            "endYear": { "type": "integer", "title": "Period End Year", "minimum": 1900, "maximum": 2200 },
                            "durationYears": { "type": "number", "title": "Duration in Years", "minimum": 1 },
                            "units": { "type": "string", "title": "Time Units", "enum": ["years", "quarters", "months"] }
                        }
                    },
                    "recordKeys": {
                        "type": "object",
                        "title": "Record Identification and Provenance",
                        "required": ["projectId", "sliceId", "methodologyVersion", "validationHash"],
                        "properties": {
                            "projectId": { "type": "string", "title": "Project ID", "minLength": 1 },
                            "sliceId": { "type": "string", "title": "VM0010 Slice Identifier", "enum": ["VM0010_V1_4_SLICE", "VM0010_V1_4_FULL"] },
                            "methodologyVersion": { "type": "string", "title": "VM0010 Methodology Version", "pattern": "^v1\\.\\d+$" },
                            "validationHash": { "type": "string", "title": "Validation Hash", "pattern": "^[0-9a-f]{64}$" },
                            "evidenceFiles": {
                                "type": "array",
                                "title": "Evidence Documentation Files",
                                "items": {
                                    "type": "object",
                                    "required": ["filename", "sha256", "url", "description"],
                                    "properties": {
                                        "filename": { "type": "string", "title": "Filename", "minLength": 1 },
                                        "sha256": { "type": "string", "title": "SHA256 Hash", "pattern": "^[0-9a-f]{64}$" },
                                        "url": { "type": "string", "title": "Source URL", "format": "uri" },
                                        "description": { "type": "string", "title": "File Description", "minLength": 1 }
                                    }
                                }
                            }
                        }
                    },
                    "validationStatus": { "type": "string", "title": "Validation Status" },
                    "validatedAt": { "type": "string", "title": "Validation Timestamp" }
                }
            }
        }
    }
}