{
    "name": "ACM0010 Monitoring Report",
    "description": "ACM0010 monitoring report submission schema. Carries monitoring-year emission reductions (ER_y) and project emissions for a single monitoring period.",
    "entity": "VC",
    "system": false,
    "sourceVersion": "1.0.0",
    "document": {
        "$id": "#monitoring-report",
        "title": "ACM0010 Monitoring Report",
        "type": "object",
        "required": ["@context", "type", "credentialSubject"],
        "properties": {
            "@context": { "type": "array", "items": { "type": "string" }, "readOnly": true },
            "type": { "type": "array", "items": { "type": "string" }, "readOnly": true },
            "credentialSubject": {
                "type": "array",
                "minItems": 1,
                "items": { "$ref": "#monitoring-report-subject" }
            }
        },
        "defs": {
            "monitoring-report-subject": {
                "type": "object",
                "required": ["ref", "monitoringYear", "baselineEmissionsTCo2e", "projectEmissionsTCo2e", "emissionReductionsTCo2e"],
                "properties": {
                    "ref": { "type": "string", "title": "Project ID", "minLength": 1 },
                    "monitoringYear": { "type": "integer", "title": "Monitoring Year", "minimum": 1900, "maximum": 2200 },
                    "baselineEmissionsTCo2e": {
                        "type": "number",
                        "title": "Baseline Emissions BE_y (tCO2e)",
                        "description": "Total baseline emissions for the monitoring year, from BE_CH4,y plus BE_N2O,y where applicable.",
                        "minimum": 0
                    },
                    "projectEmissionsTCo2e": {
                        "type": "number",
                        "title": "Project Emissions PE_y (tCO2e)",
                        "description": "Total project emissions for the monitoring year, sum of PE_AD, PE_Aer, PE_elec/heat, PE_flare, PE_transport, PE_N2O,y where applicable.",
                        "minimum": 0
                    },
                    "emissionReductionsTCo2e": {
                        "type": "number",
                        "title": "Emission Reductions ER_y (tCO2e)",
                        "description": "Net emission reductions for the monitoring year: ER_y = BE_y - PE_y - LEAD_y.",
                        "minimum": 0
                    },
                    "leakageTCo2e": {
                        "type": "number",
                        "title": "Leakage LEAD_y (tCO2e)",
                        "description": "Leakage emissions for the monitoring year. Optional; absent if no leakage applies.",
                        "minimum": 0
                    },
                    "baselineMethaneTCo2e": {
                        "type": "number",
                        "title": "Baseline Methane BE_CH4,y (tCO2e)",
                        "minimum": 0
                    },
                    "baselineN2O_TCo2e": {
                        "type": "number",
                        "title": "Baseline N2O BE_N2O,y (tCO2e)",
                        "minimum": 0
                    },
                    "projectAerobicTCo2e": {
                        "type": "number",
                        "title": "Project Aerobic PE_Aer,y (tCO2e)",
                        "minimum": 0
                    },
                    "projectN2O_TCo2e": {
                        "type": "number",
                        "title": "Project N2O PE_N2O,y (tCO2e)",
                        "minimum": 0
                    }
                }
            }
        }
    }
}
