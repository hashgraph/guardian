frontend/.nuxt/**/*
frontend/.output/**/*
# Yarn install state. The repo-root .gitignore's `.yarn/*` contains a slash, so
# it anchors to the repo root and misses these nested copies (~1.6 MB of build
# state that a `git add -A` would otherwise pick up).
.yarn/
frontend/.yarn/
*.sql
*.sql.gz
data/policy-zips/**/*
policy.json
agentic-run/
frontend/.env
design/
frontend/google-apps-script/**/*
# Snapshot bundles (built by scripts/export-snapshot.sh).
# The directory itself is kept (we ship the .gitkeep so the bind mount has a
# target) but generated dumps and shipped tarballs stay out of git.
snapshot/postgres-init/*.sql
snapshot/postgres-init/*.sql.gz
snapshot/policy-zips/
sustainability-atlas-snapshot-*.tar.gz

# Production compose overlay — kept out of git so per-deployment tweaks
# (cors origins, public URLs, redict eviction policy, etc.) don't leak.
docker-compose.prod.yml