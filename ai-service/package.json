{
    "name": "ai-service",
    "version": "3.7.1-rc",
    "main": "dist/app.js",
    "license": "Apache-2.0",
    "dependencies": {
        "@guardian/common": "workspace:*",
        "@guardian/interfaces": "workspace:*",
        "@langchain/classic": "1.0.52",
        "@langchain/community": "1.1.29",
        "@langchain/core": "1.2.14",
        "@langchain/openai": "1.6.2",
        "@langchain/textsplitters": "1.0.2",
        "dotenv": "^16.6.1",
        "faiss-node": "0.5.1",
        "reflect-metadata": "0.2.2"
    },
    "imports": {
        "#constants": "./dist/constants/index.js"
    },
    "scripts": {
        "build": "tsc",
        "build:prod": "tsc --project tsconfig.production.json",
        "debug": "nodemon dist/index.js",
        "dev:docker": "nodemon .",
        "dev": "tsc -w",
        "start": "node dist/index.js",
        "test": "mocha --file ../common/tests/helpers/quiet-console.mjs 'tests/**/*.test.mjs' --reporter mocha-junit-reporter --reporter-options mochaFile=../test_results/ai-service.xml --exit",
        "lint": "tslint --config ../tslint.json --project ."
    },
    "devDependencies": {
        "@types/node": "24.19.1",
        "nodemon": "3.1.14",
        "tslint": "^6.1.3",
        "typescript": "^5.8.3"
    },
    "engines": {
        "node": ">=24.15.0"
    },
    "type": "module"
}
