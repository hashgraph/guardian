{
    "name": "guardian-e2e-test",
    "version": "3.8.0-rc",
    "description": "This a place for quardian e2e automation test suite",
    "main": "index.js",
    "scripts": {
        "api-tests": "npx cypress run --expose \"grepTags=all,grepFilterSpecs=true\" --spec \"cypress/e2e/api-tests/**/*.cy.js\" --browser chromium",
        "e2e": "npx cypress run --browser chromium",
        "guardian:build": "scripts/local-guardian.sh build",
        "guardian:down": "scripts/local-guardian.sh down",
        "guardian:infra:down": "scripts/local-guardian.sh infra-down",
        "guardian:infra:up": "scripts/local-guardian.sh infra-up",
        "guardian:services:down": "scripts/local-guardian.sh services-down",
        "guardian:services:up": "scripts/local-guardian.sh services-up",
        "guardian:status": "scripts/local-guardian.sh status",
        "guardian:stop-policies": "scripts/local-guardian.sh stop-policies",
        "guardian:test": "scripts/local-guardian.sh test",
        "guardian:test:smoke": "scripts/local-guardian.sh smoke",
        "guardian:up": "scripts/local-guardian.sh up",
        "solo:down": "node scripts/solo-network.mjs down",
        "solo:up": "node scripts/solo-network.mjs up",
        "test": "npx cypress run --browser chromium",
        "test:scripts": "node --test \"scripts/*.test.mjs\"",
        "test:everything": "scripts/test-everything.sh",
        "test:smoke": "npx cypress run --expose \"grepTags=smoke,grepFilterSpecs=true\" --spec \"cypress/e2e/api-tests/**/*.cy.js\" --browser chromium",
        "test:tag": "./run-test-by-tag.sh",
        "ui-only-headed": "npx cypress run --headed --expose \"grepTags=ui,grepFilterSpecs=true\" --browser chromium",
        "ui-only": "npx cypress run --expose \"grepTags=ui,grepFilterSpecs=true\" --browser chromium"
    },
    "keywords": [
        "qa",
        "automation"
    ],
    "license": "ISC",
    "devDependencies": {
        "@cypress/grep": "7.0.0",
        "@eslint/js": "^10.0.1",
        "cy-verify-downloads": "0.3.0",
        "cypress": "16.3.0",
        "cypress-mochawesome-reporter": "5.0.0",
        "eslint": "^10.8.1",
        "eslint-plugin-cypress": "7.0.5",
        "globals": "^17.9.0",
        "mongodb": "6.21.0",
        "node-fetch": "3.3.2"
    },
    "dependencies": {
        "@bahmutov/cy-api": "2.3.0",
        "cypress-multi-reporters": "2.1.0",
        "cypress-real-events": "1.15.1",
        "cypress-tags": "1.2.2",
        "mocha-junit-reporter": "2.2.1",
        "util": "0.12.5",
        "uuidv4": "6.2.13"
    },
    "overrides": {
        "is-core-module": "2.13.1"
    }
}
